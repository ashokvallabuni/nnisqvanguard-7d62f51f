# ============================================================
# IVVAB AI Research Copilot & Live Search Configuration
# Server-side only. None of these keys are exposed to the client bundle.
# ============================================================
# Primary Model Provider: Google Gemini (Official @google/genai SDK)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# Optional Alternative Provider: OpenAI
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4o-mini

# Optional Research Search Provider: Tavily AI Search (https://tavily.com)
TAVILY_API_KEY=<your-tavily-api-key>

# NISQ Cyber Lab Runner — server-side only
LAB_RUNNER_URL=http://127.0.0.1:8080
LAB_RUNNER_SECRET=<your-lab-runner-secret>
LAB_DOCKER_ENABLED=true
